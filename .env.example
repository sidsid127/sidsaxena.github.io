# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public URL of this deployment, used to build Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Places API (New) — https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" on the key; no domain restriction (it's
# called server-side only, from the cron job and the photo proxy route).
GOOGLE_PLACES_API_KEY=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` — set the
# same value here and in Vercel's Cron Jobs settings.
CRON_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Price ID for the restaurant subscription plan (Product catalog → Prices)
STRIPE_PRICE_ID=price_...
# Webhook signing secret — https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — https://resend.com/api-keys (optional: booking emails are
# skipped gracefully if unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@yourdomain.com
